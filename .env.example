# 本文件仅供参考；Java 不会自动加载 .env，请先 export 或由 IDE 注入。
LLM_BASE_URL=https://llm.aiaipool.com/v1
LLM_MODEL=deepseek-v41-flash
LLM_API_KEY=请替换为自己的密钥
LLM_TIMEOUT_SECONDS=90
HOLMES_MAX_STEPS=8
HOLMES_MAX_TOOL_CALLS=24
HOLMES_TOOL_TIMEOUT_SECONDS=15
HOLMES_MAX_OUTPUT_CHARS=12000
HOLMES_MAX_CONTEXT_CHARS=120000
HOLMES_TOOLS_FILE=config/tools.json
HOLMES_RUNBOOKS_DIR=runbooks
HOLMES_PORT=8080
