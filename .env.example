# 将本文件复制为项目根目录 .env 并填入配置，已有 .env 时直接编辑。
# 启动时自动读取当前工作目录 .env；也可用 --env-file /绝对路径/.env 指定。
# 命令行参数 > 系统环境变量 > 所选 .env > 默认值；相对文件路径仍按工作目录解析。
LLM_BASE_URL=https://llm.aiaipool.com/v1
LLM_MODEL=deepseek-v41-flash
LLM_API_KEY=请替换为自己的密钥
LLM_TIMEOUT_SECONDS=90
HOLMES_MAX_STEPS=8
HOLMES_MAX_TOOL_CALLS=24
HOLMES_TOOL_TIMEOUT_SECONDS=15
HOLMES_MAX_OUTPUT_CHARS=12000
HOLMES_MAX_CONTEXT_CHARS=120000
HOLMES_TOOLS_FILE=config/tools.json
HOLMES_RUNBOOKS_DIR=runbooks
HOLMES_PORT=8080

# 网页入口：java -jar target/holmes-java-0.1.0.jar web
# 本地调试监听127.0.0.1；Docker Compose 会覆盖为容器内0.0.0.0。
HOLMES_BIND_HOST=127.0.0.1
# 首版留空直接使用；以后填入至少12字符的密码即可启用网页登录。
HOLMES_WEB_PASSWORD=
# 本地HTTP为false；通过HTTPS反向代理部署时设为true。
HOLMES_WEB_SECURE_COOKIE=false

# 独立日志首版：无需 LLM_API_KEY；默认从线上统计 GET API 读取失败任务。
HOLMES_LOG_SOURCE=scheduler-victorialogs
HOLMES_LOG_NAMESPACES=prod
HOLMES_GRAFANA_URL=https://sch-grafana.aiaipool.com
HOLMES_GRAFANA_TOKEN=
HOLMES_GRAFANA_DATASOURCE_UID=victorialogs
# 留空使用线上任务 API；显式填写文件路径（或 --tasks）时优先使用该快照。
HOLMES_LOG_TASKS_FILE=
HOLMES_SCHEDULER_URL=http://216.176.194.30:18080
# 可选 Bearer Token；留空时不发送认证头。
HOLMES_SCHEDULER_TOKEN=
HOLMES_SCHEDULER_TIMEZONE=Asia/Hong_Kong
HOLMES_SCHEDULER_PAGE_SIZE=500
HOLMES_SCHEDULER_MAX_TASKS=200000
HOLMES_SCHEDULER_TIMEOUT_SECONDS=30
HOLMES_SCHEDULER_SCAN_SECONDS=120
# 留空使用 Grafana；设置为 JSONL 路径时切换为离线来源。
HOLMES_LOG_FILE=
HOLMES_LOG_DATA_DIR=data/holmes-log
HOLMES_FLUXDROP_URL=http://allenflux.tech:8090
HOLMES_FLUXDROP_TOKEN=
# 采集、临时归档、轻量报告均使用有上限预算；字节值按 MiB 换算。
HOLMES_LOG_PAGE_SIZE=1000
HOLMES_LOG_REQUEST_SECONDS=15
HOLMES_LOG_MAX_EVENTS=100000
HOLMES_LOG_MAX_BYTES=67108864
HOLMES_LOG_SPOOL_BYTES=268435456
HOLMES_LOG_CHUNK_BYTES=16777216
HOLMES_LOG_STORE_BYTES=104857600
HOLMES_LOG_REPORT_BYTES=2097152
HOLMES_LOG_RETENTION_HOURS=168
HOLMES_LOG_JOB_SECONDS=300
